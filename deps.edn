{:paths ["src"]
 ;; org.clojure/data.json matches com-gmail's JSON codec. The four kotoba-lang
 ;; libraries are consumed via :local/root sibling checkouts (they are not yet
 ;; published to Clojars or pinned to a git tag): com-gmail (the Gmail API v1
 ;; client ingest consumes), org-ietf-oauth2 (RFC 6749/7636 request/response
 ;; shaping for auth), mail (mail.inbound/mail.message address normalization),
 ;; langchain (langchain.db, the Datomic-API-compatible in-memory EAV store
 ;; that backs LangchainDbStore).
 :deps {org.clojure/data.json {:mvn/version "2.5.0"}
        io.github.kotoba-lang/com-gmail
        {:local/root "/Users/junkawasaki/github/com-junkawasaki/orgs/kotoba-lang/com-gmail"}
        io.github.kotoba-lang/org-ietf-oauth2
        {:local/root "/Users/junkawasaki/github/com-junkawasaki/orgs/kotoba-lang/org-ietf-oauth2"}
        io.github.kotoba-lang/mail
        {:local/root "/Users/junkawasaki/github/com-junkawasaki/orgs/kotoba-lang/mail"}
        io.github.kotoba-lang/langchain
        {:local/root "/Users/junkawasaki/github/com-junkawasaki/orgs/kotoba-lang/langchain"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
